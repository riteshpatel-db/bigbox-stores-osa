# Copy to .env (gitignored) and fill in. Authentication is via a named Databricks CLI profile; no tokens here.
DATABRICKS_CONFIG_PROFILE=
# s3://<workspace external-location bucket>/bigbox_fe_bar
BUNDLE_VAR_catalog_storage_root=
# Optional: path to a Databricks CLI >= 1.27 when an older one is first on PATH.
DATABRICKS_CLI=
