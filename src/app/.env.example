# Local development only (copy to .env, which is gitignored). Deployed, the platform injects these
# from the app's resource bindings (app.yaml valueFrom). Authentication is a named CLI profile.
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_GENIE_SPACE_ID=
DATABRICKS_SERVING_ENDPOINT_NAME=
LAKEBASE_ENDPOINT=
PGHOST=
PGDATABASE=
PGPORT=5432
PGSSLMODE=require
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=bigbox-ops-app
